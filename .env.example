# ─────────────────────────────────────────────────────────────
# LifeCare Hospital Management System – Environment Configuration
# ─────────────────────────────────────────────────────────────

# Web Server Port
PORT=3000

# JSON Web Token Secret (Change to a strong random key in production)
JWT_SECRET=your_super_secret_jwt_key_here

# SQL Server Database Configuration
# Set DB_SERVER to your SQL Server host/instance (e.g., localhost or localhost\SQLEXPRESS)
DB_SERVER=localhost
DB_NAME=LifeCareDB
